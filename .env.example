# 한국투자증권 실전투자용 앱키와 앱시크릿
KIS_APP_KEY=
KIS_APP_SECRET=
# 계좌번호 12345678-01 중 앞/뒤를 분리합니다.
KIS_ACCOUNT_NUMBER=
KIS_ACCOUNT_PRODUCT_CODE=01

# false인 동안 조회만 가능하며 주문/취소는 차단됩니다.
KIS_ENABLE_REAL_TRADING=false
KIS_MAX_ORDER_KRW=1000000
KIS_MAX_ORDER_USD=1000
KIS_TIMEOUT_SECONDS=10
KIS_MIN_REQUEST_INTERVAL=1.0
KIS_TOKEN_CACHE=.kis-token.json
